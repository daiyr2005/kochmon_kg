# Для локальной разработки используйте /api; Vite проксирует его в http://localhost:8000
# Для локальной разработки оставьте /api. Для Vercel используйте API-домен AWS.
VITE_API_URL=https://api.kochmon.com.kg

# true = показывать демонстрационные данные без backend (только для просмотра дизайна)
VITE_DEMO=true

# Включайте только если в backend настроены Gemini и Google Custom Search
VITE_AI_IMAGES=true
VITE_IMAGE_SEARCH=true
